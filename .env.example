APP_NAME=Saleor FastAPI Backend
APP_VERSION=0.1.0

ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO

DB_HOST=127.0.0.1
